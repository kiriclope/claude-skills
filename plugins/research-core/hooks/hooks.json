{
  "description": "Opt-in research hooks (off unless the plugin option hooks_enabled is true): commit guard, session board, review-checkpoint prompt. See hooks/README.md.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "timeout": 10, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_if_enabled.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session_board.py\"" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "timeout": 10, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_if_enabled.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session_board.py\"" },
        { "type": "command", "timeout": 30, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_if_enabled.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/running-review-checkpoints/scripts/review_status.py\" --hook prompt" }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "timeout": 10, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_if_enabled.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_bash.py\"" },
        { "type": "command", "timeout": 10, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_if_enabled.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session_board.py\"" }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit", "hooks": [
        { "type": "command", "timeout": 10, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_if_enabled.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session_board.py\"" }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "timeout": 10, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_if_enabled.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session_board.py\"" } ] }
    ]
  }
}
